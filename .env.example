# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。

# LLM 配置
# 走 OpenAI 兼容接口；当前后端为 DeepSeek。
# 若换成其他兼容服务，同步修改 BASE_URL 与 MODEL。
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 采集配置：默认回溯天数
NEWS_DAYS_DEFAULT=1

# 兜底年报 PDF 地址（资源量取数用）
# 留空则使用内置默认值——Pilbara Minerals 2025 官方年报，可确定性抽取资源量表。
# 换标的时把它指向该公司的年报/技术报告，否则会拿锂矿年报去回答别的品种。
DEFAULT_REPORT_URL=
